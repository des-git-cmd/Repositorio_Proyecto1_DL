// Tang Nano 9K
// GW1NR-LV9QN88PC6/I5


// ============================================================
// CLOCK
// ============================================================

IO_LOC  "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;


// ============================================================
// BOTONES DE LA TANG NANO
// ============================================================

// Confirmar
IO_LOC  "btn1" 3;
IO_PORT "btn1" IO_TYPE=LVCMOS18;

// Borrar
IO_LOC  "btn2" 4;
IO_PORT "btn2" IO_TYPE=LVCMOS18;


// ============================================================
// TECLADO
// ============================================================

// Primera fila
IO_LOC  "fila1" 25;
IO_PORT "fila1" DRIVE=8 IO_TYPE=LVCMOS33;


// Columna 1 -> tecla 1
IO_LOC  "col1" 27;
IO_PORT "col1" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;


// Columna 2 -> tecla 2
IO_LOC  "col2" 28;
IO_PORT "col2" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;


// Columna 3 -> tecla 3
IO_LOC  "col3" 29;
IO_PORT "col3" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;


// Columna 4 -> tecla A
IO_LOC  "col4" 30;
IO_PORT "col4" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;


// ============================================================
// LEDs
// ============================================================

IO_LOC  "led[0]" 10;
IO_PORT "led[0]" DRIVE=8 IO_TYPE=LVCMOS18;

IO_LOC  "led[1]" 11;
IO_PORT "led[1]" DRIVE=8 IO_TYPE=LVCMOS18;

IO_LOC  "led[2]" 13;
IO_PORT "led[2]" DRIVE=8 IO_TYPE=LVCMOS18;

IO_LOC  "led[3]" 14;
IO_PORT "led[3]" DRIVE=8 IO_TYPE=LVCMOS18;

IO_LOC  "led[4]" 15;
IO_PORT "led[4]" DRIVE=8 IO_TYPE=LVCMOS18;

IO_LOC  "led[5]" 16;
IO_PORT "led[5]" DRIVE=8 IO_TYPE=LVCMOS18;


// ============================================================
// DISPLAY 7 SEGMENTOS C-391E
// ============================================================

// Segmento A
IO_LOC  "seg[0]" 51;
IO_PORT "seg[0]" DRIVE=8 IO_TYPE=LVCMOS33;

// Segmento B
IO_LOC  "seg[1]" 42;
IO_PORT "seg[1]" DRIVE=8 IO_TYPE=LVCMOS33;

// Segmento C
IO_LOC  "seg[2]" 53;
IO_PORT "seg[2]" DRIVE=8 IO_TYPE=LVCMOS33;

// Segmento D
IO_LOC  "seg[3]" 54;
IO_PORT "seg[3]" DRIVE=8 IO_TYPE=LVCMOS33;

// Segmento E
IO_LOC  "seg[4]" 55;
IO_PORT "seg[4]" DRIVE=8 IO_TYPE=LVCMOS33;

// Segmento F
IO_LOC  "seg[5]" 56;
IO_PORT "seg[5]" DRIVE=8 IO_TYPE=LVCMOS33;

// Segmento G
IO_LOC  "seg[6]" 57;
IO_PORT "seg[6]" DRIVE=8 IO_TYPE=LVCMOS33;