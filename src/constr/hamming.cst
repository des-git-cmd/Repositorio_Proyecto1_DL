// Entradas del codificador físico

IO_LOC  "palabra_pi[7]" 25;
IO_PORT "palabra_pi[7]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "palabra_pi[6]" 26;
IO_PORT "palabra_pi[6]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "palabra_pi[5]" 27;
IO_PORT "palabra_pi[5]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "palabra_pi[4]" 28;
IO_PORT "palabra_pi[4]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "palabra_pi[3]" 29;
IO_PORT "palabra_pi[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "palabra_pi[2]" 30;
IO_PORT "palabra_pi[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// Estas dos entradas son de 1.8 V.
// Necesitan divisor de voltaje externo.

IO_LOC  "palabra_pi[1]" 79;
IO_PORT "palabra_pi[1]" IO_TYPE=LVCMOS18 PULL_MODE=DOWN;

IO_LOC  "palabra_pi[0]" 80;
IO_PORT "palabra_pi[0]" IO_TYPE=LVCMOS18 PULL_MODE=DOWN;


// LED integrados: activos en bajo

IO_LOC  "led[0]" 10;
IO_PORT "led[0]" DRIVE=8 IO_TYPE=LVCMOS18;

IO_LOC  "led[1]" 11;
IO_PORT "led[1]" DRIVE=8 IO_TYPE=LVCMOS18;

IO_LOC  "led[2]" 13;
IO_PORT "led[2]" DRIVE=8 IO_TYPE=LVCMOS18;

IO_LOC  "led[3]" 14;
IO_PORT "led[3]" DRIVE=8 IO_TYPE=LVCMOS18;

IO_LOC  "led[4]" 15;
IO_PORT "led[4]" DRIVE=8 IO_TYPE=LVCMOS18;

IO_LOC  "led[5]" 16;
IO_PORT "led[5]" DRIVE=8 IO_TYPE=LVCMOS18;